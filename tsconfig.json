{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node",
      "@cloudflare/workers-types"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "app/**/*.tsx",
    "app/api/**/*.ts",
    "src/**/*.tsx",
    "worker/**/*.ts",
    "lib/auth.ts",
    "lib/civilist-db.ts",
    "lib/civilist-types.ts",
    "lib/content-validation.ts",
    "lib/utils.ts",
    "components/ui/**/*.tsx",
    "hooks/**/*.ts",
    "db/**/*.ts",
    "vite.config.ts",
    "drizzle.config.ts",
    "cloudflare-env.d.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
