{
  "name": "civilist",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "wrangler dev --local --port 8787 --ip 127.0.0.1 --inspector-port 0",
    "deploy": "node scripts/check-deploy.mjs && wrangler d1 migrations apply DB --remote --env=\"\" && wrangler deploy --env=\"\"",
    "deploy:qa": "node scripts/check-deploy.mjs --env qa && wrangler d1 migrations apply DB --remote --env qa && wrangler deploy --env qa",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "node scripts/check-deploy.mjs && wrangler d1 migrations apply DB --remote --env=\"\"",
    "db:create": "wrangler d1 create civilist-db",
    "db:configure": "node scripts/set-database.mjs",
    "db:generate": "drizzle-kit generate",
    "access:create": "node scripts/create-access.mjs",
    "access:create:qa": "node scripts/create-access.mjs --qa",
    "secrets:upload": "node scripts/check-deploy.mjs && wrangler secret bulk .civilist-secrets.json --env=\"\"",
    "secrets:upload:qa": "node scripts/check-deploy.mjs --env qa && wrangler secret bulk .civilist-secrets-qa.json --env qa",
    "test": "node --experimental-strip-types --test tests/auth.test.ts tests/deployment.test.mjs tests/assessment.test.ts tests/course-content.test.ts tests/course-import.test.ts",
    "test:api": "node tests/smoke.mjs",
    "test:integration": "node scripts/test-local-api.mjs",
    "test:ui": "node scripts/test-local-api.mjs --ui",
    "course:status": "node scripts/course-status.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
